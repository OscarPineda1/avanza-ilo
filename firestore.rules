rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Master data is public and cacheable for anonymous passengers.
    match /{collection}/{document} {
      allow read: if collection in [
        'routes', 'routeDirections', 'nodes', 'stops', 'edges',
        'routeStops', 'routeSegments', 'frequencies', 'dispatchProfiles'
      ];
      // The client never writes operational or master data. Administrative
      // writes go through trusted backend tooling (Admin SDK bypasses rules).
      allow write: if false;
    }
  }
}
