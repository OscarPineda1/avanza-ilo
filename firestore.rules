rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read access for route master data (coordinates, stops, frequencies).
    match /routes/{routeId} {
      allow read: if true;
      allow write: if false;
    }

    match /frequencies/{routeId} {
      allow read: if true;
      allow write: if false;
    }

    match /stops/{stopId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
